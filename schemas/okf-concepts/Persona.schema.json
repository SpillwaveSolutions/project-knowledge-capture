{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "type",
    "title"
  ],
  "additionalProperties": true,
  "properties": {
    "type": {
      "const": "Persona"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verified": {
      "type": "boolean"
    },
    "generated": {
      "type": "boolean"
    },
    "wiki_key": {
      "type": "string"
    },
    "truth_state": {
      "type": "string"
    },
    "schema_version": {
      "type": "integer"
    },
    "role": {
      "type": "string"
    },
    "goals": {
      "type": [
        "array",
        "string"
      ],
      "items": {
        "type": "string"
      }
    },
    "pain_points": {
      "type": [
        "array",
        "string"
      ],
      "items": {
        "type": "string"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target"
        ],
        "properties": {
          "target": {
            "type": "string"
          },
          "rel": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "$id": "https://spillwave.solutions/schemas/okf-concepts/Persona.schema.json",
  "title": "Persona",
  "description": "Who uses the product. Goals and pain points. Not a work item."
}
